  },
  "gate": {
    "two_axis": "agent_profile_t0_staff_engineer",
    "apex": "agent_profile_t0_apex_reviewer_astra",
    "$failsafe_comment": "An unavailable model must never block the work. When a seat's whole fallback chain is on dead pools, the first entry here whose tier is no STRONGER than the seat it replaces takes the ticket -- 'never up a tier' binds the failsafe too, so a T4 bulk seat lands on a T4 seat. Put seats from your most reliable credit pool here, strongest first.",
    "failsafe": [
      "agent_profile_t2_workhorse_sonnet_high",
      "agent_profile_t3_fast_sonnet_low",
      "agent_profile_t4_bulk_haiku"
    ],
    "$cross_model_comment": "Needs enough families that one dead pool cannot empty it. With only two families, one capped pool silently removes the adversarial voice from risk>=2 tickets; a third family prevents that.",
    "cross_model": [
      "agent_profile_t2_reviewer_deepseek_plan",
      "agent_profile_t2_reviewer_grok_plan",
      "agent_profile_t2_implementer_sol_medium"
    ]
  },
  "legacy_aliases": {
    "$comment": "Old seat names that still resolve, so older receipts and checkpoints keep working after a rename. Never emitted.",
