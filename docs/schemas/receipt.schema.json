{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baton:schemas:receipt",
  "title": "Agent bus GitHub receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket",
    "node",
    "outcome",
    "verified",
    "not_verified",
    "capture"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ticket": { "type": "string", "minLength": 1 },
    "node": {
      "type": "string",
      "enum": ["cursor", "claude", "opencode", "antigravity", "codex", "perplexity", "other", "dispatcher"]
    },
    "outcome": {
      "type": "string",
      "enum": ["done", "blocked", "handed_off", "failed_start"]
    },
    "commit": { "type": "string" },
    "branch": { "type": "string" },
    "verified": { "type": "array", "items": { "type": "string" } },
    "not_verified": { "type": "array", "items": { "type": "string" } },
    "capture": {
      "type": "string",
      "minLength": 1,
      "description": "Link to where durable knowledge was recorded, or the exact string nothing durable"
    }
  }
}
